# Copy to .env for Docker Compose. For a local shell, set these environment variables.
APP_ENV=development
# DATABASE_URL=sqlite:////app/storage/journeygraph.db
ADMIN_EMAIL=admin@journeygraph.local
ADMIN_PASSWORD=
JWT_SECRET=
SEED_DEMO=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CHECKPOINT_DB=checkpoints.db

# Optional: values never enter the browser bundle.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Docker PostgreSQL profile; choose a strong password.
POSTGRES_PASSWORD=
